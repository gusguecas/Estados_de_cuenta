rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Empresas - users can only access their own
    match /empresas/{empresaId} {
      allow read: if isAuthenticated();
      allow write, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Cuentas - users can only access their own
    match /cuentas/{cuentaId} {
      allow read: if isAuthenticated();
      allow write, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Movimientos - users can only access movements of their own accounts
    match /movimientos/{movimientoId} {
      allow read: if isAuthenticated();
      allow write, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Categorias - users can only access their own
    match /categorias/{categoriaId} {
      allow read: if isAuthenticated();
      allow write, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Estados de cuenta - users can only access their own
    match /estados_cuenta/{estadoId} {
      allow read: if isAuthenticated();
      allow write, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
